---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DownloadButtons from "@/components/DownloadButtons.astro";
import Screenshot from "@/components/Screenshot.astro";
import Feature from "@/components/Feature.astro";
import FaqList from "@/components/FaqList.astro";
import GovStatement from "@/components/GovStatement.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import { FAQS } from "@/data/faq";
import { COMPANY, FEATURES, SITE, SITE_URL, STORES } from "@/config/site";
import { CheckCheck, FileLock, Flame, ListChecks, Radio, Route, Share2, Accessibility, ShieldCheck, WifiOff, UserX, EyeOff, Users, User, HeartHandshake, Check, Phone, BellOff, Landmark, Stethoscope } from "@lucide/astro";
import { organizationLd } from "@/lib/seo";

const ic = "size-6";
const mobileApp = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  "@id": `${SITE_URL}/#app`,
  name: SITE.name,
  description: SITE.definition,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS, Android",
  inLanguage: "nl-NL",
  url: SITE_URL,
  downloadUrl: STORES.appStore,
  softwareVersion: SITE.appVersion,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  publisher: { "@id": `${SITE_URL}/#organization` },
};
const org = { ...organizationLd(), name: COMPANY.provider };
const audiences = [
  { icon: Users, title: "Gezinnen", text: "Reken met je hele huishouden: volwassenen, kinderen, baby’s en huisdieren. De checklist past zich aan.", tint: "blue" },
  { icon: User, title: "Alleenstaanden", text: "Een overzichtelijk pakket dat past bij één persoon, zonder dat je alles zelf hoeft uit te zoeken.", tint: "teal" },
  { icon: HeartHandshake, title: "Ouderen", text: "Grote, duidelijke tekst, rustige schermen en ruime tikdoelen. Ook handig om samen met een familielid in te vullen.", tint: "sand" },
];
const noNots = [
  { icon: Phone, title: "Vervangt geen 112", text: "Bij levensgevaar bel je 112. De app belt nooit zelf; een nummer opent alleen de telefoon-app." },
  { icon: BellOff, title: "Geen NL-Alert", text: "De app waarschuwt je niet bij een noodsituatie. Stel NL-Alert zelf in op je telefoon." },
  { icon: Landmark, title: "Niet van de overheid", text: "Een onafhankelijke app van GymWiki, niet gemaakt door of in opdracht van de overheid." },
  { icon: Stethoscope, title: "Geen medisch advies", text: "De informatie is algemeen. Twijfel je over je gezondheid, neem dan contact op met een arts." },
];
---
<BaseLayout
  title="NL-Noodpakket: noodpakket en noodplan, volledig offline"
  description="Stel stap voor stap je noodpakket en noodplan samen met de app NL-Noodpakket. Rustig, overzichtelijk, volledig offline en zonder account."
  path="/"
  jsonLd={[mobileApp, org]}
  showCrumbs={false}
>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:pt-16">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-accent px-4 py-1.5 text-sm font-semibold text-accent-foreground"><WifiOff class="size-4" aria-hidden="true" /> Volledig offline · geen account</p>
      <h1>NL-Noodpakket: rustig voorbereiden op een noodsituatie</h1>
      <p class="mt-6 max-w-2xl text-xl leading-relaxed text-muted-foreground">{SITE.definition}</p>
      <DownloadButtons class="mt-8" />
      <div class="mt-5"><LastUpdated date={SITE.lastUpdated} /></div>
    </div>
    <div class="mx-auto w-full max-w-[17rem] lg:max-w-xs">
      <Screenshot name="startscherm" alt="Startscherm van de app NL-Noodpakket met jouw paraatheid in een oogopslag (placeholder)" class="float-soft" priority />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-labelledby="voor-wie">
    <h2 id="voor-wie">Voor wie is NL-Noodpakket?</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">Voor ieder huishouden dat zich rustig wil voorbereiden, hoe groot of klein ook.</p>
    <ul class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3 [&>li]:min-w-0">
      {audiences.map((a) => (
        <li class="rounded-2xl border border-border bg-card p-6">
          <span class:list={["tint tint-bubble flex size-12 items-center justify-center rounded-2xl", `tint-${a.tint}`]}><a.icon class={ic} aria-hidden="true" /></span>
          <h3 class="mt-4">{a.title}</h3>
          <p class="mt-2 text-muted-foreground">{a.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-labelledby="functies">
    <h2 id="functies">Wat kan de app?</h2>
    <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 [&>li]:min-w-0">
      <Feature title="Checklist met houdbaarheid" tint="green"><ListChecks slot="icon" class={ic} aria-hidden="true" />Stel je noodpakket samen en zie in één overzicht wat bijna over datum is.</Feature>
      <Feature title="Noodplan delen als pdf, tekst of QR" tint="blue"><Share2 slot="icon" class={ic} aria-hidden="true" />Maak een noodplan voor je huishouden en deel het met mensen die je vertrouwt.</Feature>
      <Feature title="Stappenplannen voor meer dan 20 noodsituaties" tint="indigo"><Route slot="icon" class={ic} aria-hidden="true" />Overzichtelijke stappenplannen op basis van openbare bronnen, met bronvermelding.</Feature>
      <Feature title="Documentenkluis met biometrie" tint="teal"><FileLock slot="icon" class={ic} aria-hidden="true" />Bewaar kopieën van belangrijke documenten versleuteld op je toestel, te openen met vingerafdruk of gezicht.</Feature>
      <Feature title="Rampenzender per regio" tint="sand"><Radio slot="icon" class={ic} aria-hidden="true" />Kies je gemeente en zie vooraf de radiofrequenties van jouw regio. Zonder locatie en offline.</Feature>
      {FEATURES.noodmodus
        ? <Feature title="Noodmodus en Eerste-uur kaart" tint="pink"><Flame slot="icon" class={ic} aria-hidden="true" />Een rustige weergave met alleen wat je op dat moment nodig hebt, en een kaart voor het eerste uur.</Feature>
        : <Feature title="Eerste-uur kaart" tint="pink"><Flame slot="icon" class={ic} aria-hidden="true" />Een kaart met wat je het eerste uur van een noodsituatie kunt doen, altijd bij de hand.</Feature>}
      <Feature title="Meterkastkaart" tint="sand"><CheckCheck slot="icon" class={ic} aria-hidden="true" />Een afdrukbare kaart voor in je meterkast, met de belangrijkste gegevens uit je plan.</Feature>
      <Feature title="Toegankelijk ontworpen" tint="green"><Accessibility slot="icon" class={ic} aria-hidden="true" />Grote tikdoelen, labels voor schermlezers en respect voor de tekstgrootte van je toestel.</Feature>
    </ul>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <Screenshot name="pakket" alt="Checklist van het noodpakket met houdbaarheid (placeholder)" />
      <Screenshot name="noodplan" alt="Noodplan delen via pdf, tekst of QR-code (placeholder)" />
      <Screenshot name="stappenplan" alt="Stappenplan bij een noodsituatie (placeholder)" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-labelledby="prijzen">
    <h2 id="prijzen">Gratis en Pro</h2>
    <p class="mt-3 max-w-2xl text-muted-foreground">Het meeste is gratis. Pro is een eenmalige aankoop, geen abonnement.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-border bg-card p-6">
        <h3>Gratis</h3>
        <ul class="mt-4 space-y-3">
          {["Checklist voor je noodpakket", "Houdbaarheidsoverzicht", "Alle stappenplannen", "Noodplan", ...(FEATURES.noodmodus ? ["Noodmodus"] : []), "Documentenkluis tot 3 documenten"].map((t) => (
            <li class="flex gap-3"><Check class="mt-1 size-5 shrink-0 text-primary" aria-hidden="true" /><span>{t}</span></li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border-2 border-primary bg-card p-6">
        <h3>Pro <span class="ml-2 rounded-full bg-accent px-3 py-1 align-middle text-sm font-semibold text-accent-foreground">Eenmalig</span></h3>
        <ul class="mt-4 space-y-3">
          {["Noodhacks", "Vervangherinneringen", "Onbeperkt documenten in de kluis"].map((t) => (
            <li class="flex gap-3"><Check class="mt-1 size-5 shrink-0 text-primary" aria-hidden="true" /><span>{t}</span></li>
          ))}
        </ul>
        <p class="mt-4 text-sm text-muted-foreground">Aankoop via de App Store of Google Play. De actuele prijs zie je in de winkel.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-labelledby="privacy">
    <h2 id="privacy">Je gegevens blijven van jou</h2>
    <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3 [&>li]:min-w-0">
      <li class="rounded-2xl border border-border bg-card p-6"><WifiOff class="size-7 text-primary" aria-hidden="true" /><h3 class="mt-3">Volledig offline</h3><p class="mt-2 text-muted-foreground">Alles wat je invult blijft op je eigen toestel.</p></li>
      <li class="rounded-2xl border border-border bg-card p-6"><UserX class="size-7 text-primary" aria-hidden="true" /><h3 class="mt-3">Geen account</h3><p class="mt-2 text-muted-foreground">Geen e-mailadres, geen inloggen, geen profiel.</p></li>
      <li class="rounded-2xl border border-border bg-card p-6"><EyeOff class="size-7 text-primary" aria-hidden="true" /><h3 class="mt-3">Geen tracking</h3><p class="mt-2 text-muted-foreground">Geen analyse, geen advertenties, geen cookies op deze site.</p></li>
    </ul>
    <p class="mt-6"><a class="link inline-flex min-h-12 items-center" href="/privacy"><ShieldCheck class="mr-2 size-5" aria-hidden="true" />Lees het privacybeleid</a></p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" aria-labelledby="niet">
    <h2 id="niet">Wat de app niet doet</h2>
    <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 [&>li]:min-w-0">
      {noNots.map((n) => (
        <li class="flex gap-4 rounded-2xl border border-border bg-card p-5">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-muted text-foreground"><n.icon class={ic} aria-hidden="true" /></span>
          <div class="min-w-0"><h3>{n.title}</h3><p class="mt-1 text-muted-foreground">{n.text}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6" aria-labelledby="faq">
    <h2 id="faq">Veelgestelde vragen</h2>
    <div class="mt-8"><FaqList items={FAQS.filter((f) => f.home)} /></div>
    <p class="mt-6"><a class="link inline-flex min-h-12 items-center font-semibold" href="/veelgestelde-vragen">Alle veelgestelde vragen</a></p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6"><GovStatement /></section>
</BaseLayout>
