---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GovStatement from "@/components/GovStatement.astro";
import { COMPANY } from "@/config/site";
import { Mail } from "@lucide/astro";
---
<BaseLayout
  title="Contact en support"
  description="Contact en support voor NL-Noodpakket: stuur een e-mail naar GymWiki, de aanbieder van de app. Bedrijfsgegevens en KVK-nummer."
  path="/contact"
>
  <div class="mx-auto max-w-3xl px-4 pb-8 pt-4 sm:px-6">
    <h1>Contact en support</h1>
    <p class="mt-5 text-xl text-muted-foreground">Een vraag over de app, een fout in de inhoud of een privacyvraag? Stuur ons een e-mail.</p>
    <div class="mt-8 rounded-2xl border border-border bg-card p-6">
      <h2 class="!text-xl">E-mail</h2>
      <p class="mt-3"><a class="link inline-flex min-h-12 items-center gap-2 text-lg font-semibold" href={`mailto:${COMPANY.email}`}><Mail class="size-5" aria-hidden="true" />{COMPANY.email}</a></p>
      {COMPANY.emailIsPlaceholder && <p class="mt-2 text-sm text-warm" data-todo>TODO: dit e-mailadres is een placeholder en moet nog worden ingevuld.</p>}
      <p class="mt-3 text-muted-foreground">Stuur geen gevoelige gegevens mee, zoals kopieën van documenten. Bij levensgevaar bel je 112.</p>
    </div>
    <div class="mt-6 rounded-2xl border border-border bg-card p-6">
      <h2 class="!text-xl">Bedrijfsgegevens</h2>
      <dl class="mt-3 grid grid-cols-[8rem_1fr] gap-y-2">
        <dt class="text-muted-foreground">Aanbieder</dt><dd>{COMPANY.provider}</dd>
        <dt class="text-muted-foreground">KVK-nummer</dt><dd>{COMPANY.kvk}</dd>
        <dt class="text-muted-foreground">Vestigingsplaats</dt><dd>{COMPANY.city}</dd>
      </dl>
    </div>
    <div class="mt-10"><GovStatement compact /></div>
  </div>
</BaseLayout>
