---
import Logo from "./Logo.astro";
import GovStatement from "./GovStatement.astro";
import { COMPANY, LEGAL_NAV, NAV, SITE } from "@/config/site";
const link = "inline-flex min-h-12 items-center text-foreground no-underline hover:underline";
---
<footer class="mt-24 border-t border-border bg-card">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <GovStatement compact footer />
    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <div>
        <p class="flex items-center gap-3 font-heading text-lg font-bold"><Logo class="size-8" /> {SITE.name}</p>
        <p class="mt-3 text-[0.95rem] text-muted-foreground">{SITE.tagline}</p>
        <p class="mt-3 text-[0.95rem] text-muted-foreground">Bij levensgevaar bel je 112.</p>
      </div>
      <nav aria-label="Pagina’s">
        <h2 class="!text-base">Pagina’s</h2>
        <ul class="mt-2">{NAV.map((i) => <li><a class={link} href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Juridisch">
        <h2 class="!text-base">Juridisch</h2>
        <ul class="mt-2">{LEGAL_NAV.map((i) => <li><a class={link} href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
    </div>
    <p class="mt-10 text-sm text-muted-foreground">© {new Date().getFullYear()} {COMPANY.provider} · KVK {COMPANY.kvk} · {COMPANY.city}</p>
  </div>
</footer>
