---
import { ChevronDown } from "@lucide/astro";
import type { Faq } from "@/data/faq";
interface Props { items: Faq[]; level?: 2 | 3 }
const { items, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";

/** Zet het eerste voorkomen van elke linktekst om in een link; de zichtbare tekst verandert niet. */
function parts(f: Faq) {
  let rest: { t: string; href?: string }[] = [{ t: f.a }];
  for (const l of f.links ?? []) {
    rest = rest.flatMap((p) => {
      if (p.href) return [p];
      const i = p.t.indexOf(l.text);
      return i < 0 ? [p] : [{ t: p.t.slice(0, i) }, { t: l.text, href: l.href }, { t: p.t.slice(i + l.text.length) }];
    });
  }
  return rest;
}
---
<div class="divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card">
  {items.map((f) => (
    <details class="group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 marker:hidden [&::-webkit-details-marker]:hidden hover:bg-muted">
        <Heading class="min-w-0 flex-1 font-heading !text-lg font-semibold">{f.q}</Heading>
        <ChevronDown class="size-5 shrink-0 text-primary transition-transform group-open:rotate-180" aria-hidden="true" />
      </summary>
      <p class="px-5 pb-5 text-muted-foreground">{parts(f).map((p) => (p.href ? <a class="link" href={p.href}>{p.t}</a> : p.t))}</p>
    </details>
  ))}
</div>
