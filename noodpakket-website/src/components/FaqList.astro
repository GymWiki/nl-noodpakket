---
import { ChevronDown } from "@lucide/astro";
import type { Faq } from "@/data/faq";
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card">
  {items.map((f) => (
    <details class="group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-heading text-lg font-semibold marker:hidden [&::-webkit-details-marker]:hidden hover:bg-muted">
        <span>{f.q}</span>
        <ChevronDown class="size-5 shrink-0 text-primary transition-transform group-open:rotate-180" aria-hidden="true" />
      </summary>
      <p class="px-5 pb-5 text-muted-foreground">{f.a}</p>
    </details>
  ))}
</div>
