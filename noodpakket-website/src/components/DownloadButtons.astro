---
import { STORES } from "@/config/site";
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
// TODO: vervang de tekstknoppen door de officiële badges (zie README, sectie 'Store-badges').
const btn = "inline-flex min-h-12 items-center justify-center gap-2 rounded-xl px-6 py-3 font-semibold no-underline transition-colors";
---
<div class:list={["flex flex-wrap items-center gap-3", cls]}>
  <a class:list={[btn, "bg-foreground text-background hover:opacity-90"]} href={STORES.appStore} rel="noopener" data-store="app-store">
    <span aria-hidden="true"></span>
    <span><span class="block text-xs font-normal leading-none opacity-80">Download in de</span>App Store</span>
  </a>
  {STORES.googlePlay ? (
    <a class:list={[btn, "bg-foreground text-background hover:opacity-90"]} href={STORES.googlePlay} rel="noopener" data-store="google-play">
      <span><span class="block text-xs font-normal leading-none opacity-80">Ontdek het op</span>Google Play</span>
    </a>
  ) : (
    <span class:list={[btn, "cursor-not-allowed border border-dashed border-border bg-muted text-muted-foreground"]} role="note">
      <span><span class="block text-xs font-normal leading-none">Google Play</span>Binnenkort beschikbaar</span>
    </span>
  )}
</div>
